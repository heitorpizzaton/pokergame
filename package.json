{
  "name": "mesa-viva",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "detect-gpu": "^5.0.70",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jiti": "^2.7.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:long": "vitest run --config vitest.long.config.ts",
    "bench:eval": "node scripts/bench-eval.ts",
    "sim": "node scripts/sim.ts",
    "e2e": "vite build --mode e2e && playwright test && playwright test --config playwright.perf.config.ts",
    "budget": "node scripts/check-bundle.ts",
    "visual": "vite build --mode e2e && playwright test --config playwright.visual.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.ts",
    "gen:preflop": "node scripts/gen-preflop-table.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run budget && npm run assets:check && npm run e2e",
    "looks": "vite build --mode e2e && playwright test --config playwright.looks.config.ts",
    "assets:characters": "node scripts/assets/characters.ts",
    "assets:build": "node scripts/assets/characters.ts",
    "assets:check": "node scripts/assets/check.ts",
    "assets:setup": "bash scripts/assets/setup.sh"
  }
}
